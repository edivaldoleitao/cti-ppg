[2026-06-02 13:01:23] Fuseki     INFO  [52] Query = PREFIX cti: <http://gic.ufrpe.br/cti/vocabulary/cti#>  SELECT ?nomePPG ?modalidade ?conceitoCAPES ?qtdDocentesPermanentes ?qtdDiscentes ?totalPublicacoes ?totalCitacoesArtigos ?hIndexMedioDocentes WHERE {     # 1. Dados Base do PPG e seu Conceito de Avaliação (CAPES)     ?ppg a cti:PPG ;          cti:nm_programa_ies ?nomePPG ;          cti:nm_modalidade_programa ?modalidade ;          cti:avaliado ?conceitoObj .     ?conceitoObj cti:cd_conceito_programa ?conceitoCAPES .      # 2. Métrica: Total de Docentes Permanentes (Liderança do Programa)     OPTIONAL {         SELECT ?ppg (COUNT(DISTINCT ?docente) AS ?qtdDocentesPermanentes) WHERE {             ?docente a cti:Docente ;                      cti:membro ?ppg ;                      cti:ds_tipo_vinculo_docente_ies "PERMANENTE" .         } GROUP BY ?ppg     }      # 3. Métrica: Total de Discentes Ativos/Egressos (Escopo de Orientação)     OPTIONAL {         SELECT ?ppg (COUNT(DISTINCT ?discente) AS ?qtdDiscentes) WHERE {             ?discente a cti:Discente ;                       cti:vinculado ?ppg .         } GROUP BY ?ppg     }      # 4. Métrica: Produtividade Científica dos Membros do PPG     OPTIONAL {         SELECT ?ppg (COUNT(DISTINCT ?producao) AS ?totalPublicacoes) (SUM(?citacoesPub) AS ?totalCitacoesArtigos) WHERE {             ?docente a cti:Docente ;                      cti:membro ?ppg ;                      cti:nm_persona_nome_ou_equivalente_nm_pessoa ?nomePessoa . # Cruzamento por nome textual             ?autor a cti:Autor ;                    cti:nm_pessoa ?nomePessoa .             ?producao a cti:Producao_Cientifica ;                       cti:autoria ?autor ;                       cti:nr_citacoes_publicacao ?citacoesPub .         } GROUP BY ?ppg     }      # 5. Métrica: Impacto Acumulado e Senioridade do Corpo Docente (Média de Índice H)     OPTIONAL {         SELECT ?ppg (AVG(?indiceH) AS ?hIndexMedioDocentes) WHERE {             ?docente a cti:Docente ;                      cti:membro ?ppg ;                      cti:nm_pessoa ?nomePessoa .             ?autor a cti:Autor ;                    cti:nm_pessoa ?nomePessoa ;                    cti:mensurado ?citacaoObj .             ?citacaoObj cti:nr_indice_h ?indiceH .         } GROUP BY ?ppg     } } ORDER BY DESC(?conceitoCAPES) DESC(?hIndexMedioDocentes) DESC(?totalPublicacoes)
